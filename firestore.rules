rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profile validation
    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'username', 'displayName', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'username', 'displayName', 'email', 'avatar', 'passwordHash', 'role', 'xp', 'level', 'streakDays', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId.size() <= 128 &&
        data.username is string && data.username.size() >= 3 && data.username.size() <= 50 &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 100 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
        (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 30)) &&
        (!('passwordHash' in data) || (data.passwordHash is string && data.passwordHash.size() <= 128)) &&
        (!('role' in data) || data.role in ['student', 'admin', 'teacher']) &&
        (!('xp' in data) || data.xp is number) &&
        (!('level' in data) || data.level is number) &&
        (!('streakDays' in data) || data.streakDays is number) &&
        data.createdAt is string;
    }

    // Test result validation
    function isValidTestResult(data) {
      return data.keys().hasAll(['id', 'userId', 'subject', 'score', 'total', 'completedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'userName', 'subject', 'topic', 'score', 'total', 'completedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.subject is string && data.subject.size() <= 100 &&
        data.score is number && data.score >= 0 &&
        data.total is number && data.total > 0 &&
        data.completedAt is string;
    }

    // Competition entry validation
    function isValidCompetitionEntry(data) {
      return data.keys().hasAll(['id', 'userId', 'score', 'totalQuestions', 'timeSpentSeconds', 'completedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'userName', 'subject', 'score', 'totalQuestions', 'timeSpentSeconds', 'completedAt', 'avatar', 'region']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.score is number && data.score >= 0 &&
        data.totalQuestions is number && data.totalQuestions > 0 &&
        data.timeSpentSeconds is number && data.timeSpentSeconds >= 0 &&
        data.completedAt is string;
    }

    // 1. Users collection
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isValidId(userId) && isValidUser(incoming()) && (incoming().userId == userId || incoming().userId == request.auth.uid);
      allow update: if isValidId(userId) && isValidUser(incoming()) && (existing().userId == userId || existing().userId == request.auth.uid);
      allow delete: if false;
    }

    // 2. Test results collection
    match /testResults/{resultId} {
      allow get, list: if isSignedIn();
      allow create: if isValidId(resultId) && isValidTestResult(incoming()) && (incoming().userId == request.auth.uid || incoming().userId.size() > 0);
      allow update: if isValidId(resultId) && isValidTestResult(incoming());
      allow delete: if false;
    }

    // 3. Competition entries collection
    match /competitionEntries/{entryId} {
      allow get, list: if true;
      allow create: if isValidId(entryId) && isValidCompetitionEntry(incoming());
      allow update: if isValidId(entryId) && isValidCompetitionEntry(incoming());
      allow delete: if false;
    }
  }
}
